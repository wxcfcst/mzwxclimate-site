/* MZ WX & Climate — Background original restaurado */

body.mz-home main.mz-home-content {
    position: relative !important;
    isolation: isolate;

    background-image: url("../images/home/mzw-home-satellite.webp") !important;
    background-color: #f3f7fb;
    background-position: center center !important;
    background-size: cover !important;
    background-repeat: no-repeat !important;
}

/* Camada escura original: 24% */
body.mz-home main.mz-home-content::before {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(8, 23, 36, 0.24) !important;
    z-index: 0;
    pointer-events: none;
}

/* Preservar o conteúdo acima do background */
body.mz-home main.mz-home-content > * {
    position: relative;
    z-index: 1;
}
