/* Oculto por padrão; não altera a coluna esquerda */
body.mz-home .mz-home-content { position: relative; }
body.mz-home #mz-cyclone-live-alert[hidden] { display: none !important; }
body.mz-home #mz-cyclone-live-alert:not([hidden]) {
  position: absolute; top: 28px; right: max(3.5%, 24px);
  z-index: 5; width: min(360px, 35%); box-sizing: border-box;
  border-radius: 12px; padding: 18px 20px;
  border: 2px solid #e7a62e; background: rgba(255, 252, 241, .96);
  color: #13283a; box-shadow: 0 10px 28px rgba(0, 0, 0, .18);
}
body.mz-home .mz-cyclone-alert-title { font-weight: 750; font-size: 1.08rem; margin: 0 0 8px; }
body.mz-home .mz-cyclone-alert-text { margin: 0 0 10px; line-height: 1.45; }
body.mz-home .mz-cyclone-live-alert a { color: #064f82; font-weight: 700; }
body.mz-home .mz-cyclone-alert-badge { animation: mzw-alert-pulse 1.8s ease-in-out infinite; }
@keyframes mzw-alert-pulse { 50% { opacity: .28; } }
@media (prefers-reduced-motion: reduce) { body.mz-home .mz-cyclone-alert-badge {animation:none;} }
@media (max-width: 900px) {
 body.mz-home #mz-cyclone-live-alert:not([hidden]) {
   position: relative; top: auto; right: auto; width: min(100%, 440px);
   margin: 16px 0 20px; 
 }
}

/* MZ WX & Climate — Alerta ciclónico transparente */

#mz-cyclone-live-alert:not([hidden]) {
    background: rgba(255, 210, 35, 0.16) !important;
    border: 2px solid #e8a900 !important;
    border-radius: 14px;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    box-shadow: 0 4px 18px rgba(0,0,0,0.12);
    transition: background-color 0.5s, border-color 0.5s;
}

/* Título e mensagem com pulsação suave */
#mz-cyclone-live-alert .mz-cyclone-alert-title,
#mz-cyclone-live-alert .mz-cyclone-alert-text {
    animation: mzCycloneBlink 2.5s ease-in-out infinite;
}

/* Destaque do ícone */
#mz-cyclone-live-alert .mz-cyclone-alert-badge {
    animation: mzCycloneBlink 1.6s ease-in-out infinite;
}

@keyframes mzCycloneBlink {
    0%, 100% {
        opacity: 1;
    }
    50% {
        opacity: 0.65;
    }
}

/* Respeitar preferência por movimento reduzido */
@media (prefers-reduced-motion: reduce) {
    #mz-cyclone-live-alert * {
        animation: none !important;
    }
}

